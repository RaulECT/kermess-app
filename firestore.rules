rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // config/event — lectura pública; escritura SOLO Cloud Function
    // ─────────────────────────────────────────────
    match /config/event {
      allow read: if true;
      allow write: if false;
    }

    // ─────────────────────────────────────────────
    // users/{userId}
    // Lectura pública (quien tiene el link con userId puede leer).
    // Escritura SOLO Cloud Function.
    // ─────────────────────────────────────────────
    match /users/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // ─────────────────────────────────────────────
    // stations/{stationId}
    // Lectura pública (menús y precios).
    // Escritura SOLO Cloud Function.
    // ─────────────────────────────────────────────
    match /stations/{stationId} {
      allow read: if true;
      allow write: if false;
    }

    // ─────────────────────────────────────────────
    // operators/{operatorId}
    // Sin lectura directa desde cliente (validación en Cloud Function).
    // Escritura SOLO Cloud Function.
    // ─────────────────────────────────────────────
    match /operators/{operatorId} {
      allow read: if false;
      allow write: if false;
    }

    // ─────────────────────────────────────────────
    // admins/{adminId}
    // Sin lectura directa desde cliente.
    // Escritura SOLO Cloud Function.
    // ─────────────────────────────────────────────
    match /admins/{adminId} {
      allow read: if false;
      allow write: if false;
    }

    // ─────────────────────────────────────────────
    // transactions/{txId}
    // Creación y escritura SOLO Cloud Function.
    // Lectura: solo la propia tx del usuario (por userId).
    // (Las queries admin pasan también por Cloud Function / server-side.)
    // ─────────────────────────────────────────────
    match /transactions/{txId} {
      // Lectura permitida: el qrToken (= userId) es la credencial del asistente.
      // El cliente siempre filtra por userId. Aplica el mismo modelo de seguridad que /users.
      allow read: if true;
      allow write: if false;
    }

    // ─────────────────────────────────────────────
    // auditLog/{logId}
    // Lectura y escritura SOLO Cloud Function / admin server-side.
    // ─────────────────────────────────────────────
    match /auditLog/{logId} {
      // Lectura pública (solo admin accede vía PIN, no hay datos sensibles de usuarios)
      allow read: if true;
      allow write: if false;
    }

    // ─────────────────────────────────────────────
    // systemErrors/{errorId}
    // Escritura SOLO Cloud Function (admin SDK).
    // Lectura pública (protegida por token secreto en la URL del cliente).
    // ─────────────────────────────────────────────
    match /systemErrors/{errorId} {
      allow read, update: if true;
      allow create, delete: if false;
    }

    // Denegar todo lo demás por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
